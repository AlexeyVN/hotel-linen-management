# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.
# Внимание: Prisma разрешает относительный путь SQLite от каталога prisma/, поэтому ../data
DATABASE_URL="file:../data/app.db"
# В production — точный внешний URL с https, иначе QR будет вести на localhost.
NEXTAUTH_URL="http://localhost:3000"
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=""
TZ="Europe/Moscow"
LOG_LEVEL="info"
# Необязательно: Bearer-токен для POST /api/integration/worker (Task Scheduler).
# Если не задан, эндпоинт требует сессию с правом settings.integration.
INTEGRATION_WORKER_TOKEN=""
# Язык и валюта новой установки. Текущая установка хранит выбор в Setting.
APP_DEFAULT_LOCALE="en"
APP_DEFAULT_CURRENCY="USD"
